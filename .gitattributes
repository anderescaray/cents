# Normalize text files to LF in the repository
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf

# The Gradle wrapper script runs on Linux CI: it must stay LF
gradlew text eol=lf

# Binaries: never touch
*.jar binary
*.ttf binary
*.otf binary
*.webp binary
*.png binary
*.jpg binary
*.keystore binary
*.jks binary
