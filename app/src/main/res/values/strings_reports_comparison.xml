<?xml version="1.0" encoding="utf-8"?>
<!--
    The period-comparison view's own strings.

    A file of its own rather than more lines in strings.xml, for the reason given in
    strings_reports_balance.xml: a resource file per view is one more thing a new view adds
    instead of a place several of them collide.
-->
<resources>
    <string name="reports_comparison_header">This period against the last</string>
    <string name="reports_comparison_empty">Nothing happened in either period.</string>
    <string name="reports_comparison_legend_before">Previous period</string>
    <string name="reports_comparison_legend_current">This period</string>
    <string name="reports_comparison_unchanged">no change</string>
    <string name="reports_comparison_open_before">Movements in the previous period</string>
    <string name="reports_comparison_partial">This period has not finished, so it is compared against the same stretch of the previous one.</string>
</resources>
