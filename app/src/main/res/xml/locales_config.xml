<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages the app can be shown in, which Android 13+ lists under the phone's App languages
  as well as in Settings › Language. English is the default resources; Spanish is values-es.
  A language added here needs its resources first (CLAUDE.md rule 10).
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
</locale-config>
