<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The runtime permission for reminders and optional capture confirmations on Android 13+.
      It is requested from the subscription editor when a reminder is added, or from Capture
      when confirmations are enabled, rather than on first launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Which apps capture could read (DECISIONS.md D29). Since Android 11 the package manager only
      answers for what is declared here, and this asks for the launcher's apps — the ones the
      owner recognises by name — rather than QUERY_ALL_PACKAGES, which Play reserves for apps
      whose purpose is managing other apps.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CentsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cents">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cents"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Capture from notifications (PRD 4.6, D29). Android lists it under Notification access,
          where only the owner can switch it on; until they do, it hears nothing. The permission
          is the system's to hold, so no other app can bind to it.
        -->
        <service
            android:name=".ui.capture.CaptureListenerService"
            android:exported="true"
            android:label="@string/capture_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>